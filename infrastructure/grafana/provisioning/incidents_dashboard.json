{
  "uid": "ops-agent-incidents",
  "title": "Incidents",
  "description": "Notes the infrastructure agent wrote for platform alerts (ADR-0046). Generated text: advice beside the alert, not a diagnosis.",
  "tags": [
    "industryflow",
    "ops-agent"
  ],
  "schemaVersion": 38,
  "version": 2,
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "loki",
          "uid": "Loki"
        },
        "enable": false,
        "hide": false,
        "iconColor": "orange",
        "name": "Incident notes",
        "expr": "{job=\"ops-agent\"}",
        "target": {
          "expr": "{job=\"ops-agent\"}",
          "refId": "Anno"
        },
        "textFormat": "{{alertname}}",
        "tagKeys": "alertname,severity",
        "titleFormat": "Incident note"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "alertname",
        "label": "Alert",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "Loki"
        },
        "query": {
          "label": "alertname",
          "stream": "{job=\"ops-agent\"}",
          "type": 1,
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values({job=\"ops-agent\"}, alertname)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "severity",
        "label": "Priority",
        "type": "custom",
        "query": "critical,warning,info",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "incident",
        "label": "Incident",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0,
        "description": "The fingerprint of the incident to show in the detail panel; empty shows the newest."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "P1 critical",
      "description": "Critical alerts the agent explained in the selected time range.",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum(count_over_time({job=\"ops-agent\", alertname=~\"$alertname\", severity=\"critical\"}[$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "#d03b3b",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "P2 warning",
      "description": "Warning alerts the agent explained in the selected time range.",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum(count_over_time({job=\"ops-agent\", alertname=~\"$alertname\", severity=\"warning\"}[$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "#fab219",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "All incidents",
      "description": "Every alert the agent explained in the selected time range, all priorities.",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum(count_over_time({job=\"ops-agent\", alertname=~\"$alertname\", severity=~\"$severity\"}[$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "text",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Written without a model",
      "description": "Notes the agent built from the evidence alone, because no model answered.",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum(count_over_time({job=\"ops-agent\", alertname=~\"$alertname\", severity=~\"$severity\"} | json model=\"model\" | model=\"none\" [$__range]))",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              },
              {
                "color": "text",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Incidents per hour, by priority",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "description": "How many alerts the agent explained per hour, stacked by priority.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum by (severity) (count_over_time({job=\"ops-agent\", alertname=~\"$alertname\", severity=~\"$severity\"}[1h]))",
          "legendFormat": "{{severity}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#8a8a85"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 100,
            "lineWidth": 0,
            "barAlignment": 0,
            "gradientMode": "none",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "showPoints": "never",
            "axisGridShow": true,
            "axisPlacement": "auto",
            "barWidthFactor": 0.6
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "critical"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d03b3b"
                }
              },
              {
                "id": "displayName",
                "value": "P1 critical"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warning"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#fab219"
                }
              },
              {
                "id": "displayName",
                "value": "P2 warning"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1h"
    },
    {
      "id": 6,
      "type": "table",
      "title": "Incidents: highest priority first. Click an alert to open it below",
      "description": "One row per alert the agent explained. Sorted by priority, newest first within a priority.",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "queryType": "range",
          "maxLines": 500,
          "expr": "{job=\"ops-agent\", alertname=~\"$alertname\", severity=~\"$severity\"} | json services=\"services\", what=\"what\", cause=\"cause\", next_step=\"next_step\", model=\"model\", fingerprint=\"fingerprint\" | label_format prio=`{{ if eq .severity \"critical\" }}1{{ else if eq .severity \"warning\" }}2{{ else if eq .severity \"info\" }}3{{ else }}4{{ end }}`"
        }
      ],
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "labels",
            "format": "auto",
            "replace": false,
            "keepTime": false
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "prio",
                "desc": false
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "Time": true,
              "severity": true,
              "alertname": true,
              "services": true,
              "what": true,
              "cause": true,
              "next_step": true,
              "model": true,
              "fingerprint": true,
              "prio": true
            },
            "indexByName": {
              "severity": 0,
              "Time": 1,
              "alertname": 2,
              "services": 3,
              "what": 4,
              "cause": 5,
              "next_step": 6,
              "model": 7,
              "fingerprint": 8,
              "prio": 9
            },
            "renameByName": {
              "severity": "Priority",
              "Time": "Time",
              "alertname": "Alert",
              "services": "Services",
              "what": "What happened",
              "cause": "Likely cause",
              "next_step": "Next step",
              "model": "Written by"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto",
              "wrapText": true
            },
            "inspect": true,
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Priority"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "text": "P1 critical",
                        "color": "#d03b3b",
                        "index": 0
                      },
                      "warning": {
                        "text": "P2 warning",
                        "color": "#fab219",
                        "index": 1
                      },
                      "info": {
                        "text": "P3 info",
                        "color": "#8a8a85",
                        "index": 2
                      }
                    }
                  },
                  {
                    "type": "special",
                    "options": {
                      "match": "null+nan",
                      "result": {
                        "text": "P4 unknown",
                        "color": "#8a8a85",
                        "index": 3
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "custom.width",
                "value": 120
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 175
              },
              {
                "id": "unit",
                "value": "time:YYYY-MM-DD HH:mm:ss"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Alert"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 240
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open this incident",
                    "url": "/grafana/d/ops-agent-incidents/incidents?${__url_time_range}&var-incident=${__data.fields.fingerprint}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Services"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 180
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Written by"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fingerprint"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "prio"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Incident detail: the one picked in the table, or the newest",
      "description": "The full note for one alert, with the evidence it cites. Generated text: advice beside the alert, not a diagnosis.",
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "queryType": "range",
          "maxLines": 1,
          "expr": "{job=\"ops-agent\"} |= \"$incident\" | json | line_format \"{{.alertname}}    {{ if eq .severity \\\"critical\\\" }}P1 critical{{ else if eq .severity \\\"warning\\\" }}P2 warning{{ else }}{{.severity}}{{ end }}    {{.services}}\\n\\n{{ if .what }}WHAT HAPPENED\\n{{.what}}\\n\\nIMPACT\\n{{.impact}}\\n\\nLIKELY CAUSE\\n{{.cause}}\\n\\nNEXT STEP\\n{{.next_step}}\\n\\nWritten by {{.model}}. Advice beside the alert, not a diagnosis.{{ else }}{{.text}}{{ end }}\\n\\nEvidence: {{.evidence}}\\nRedacted: {{.redacted}}\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": false
      }
    }
  ]
}
