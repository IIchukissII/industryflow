# IndustryFlow v2 Environment Configuration
# Version: 4.0 - NEW ARCHITECTURE
# Copy this file to .env and customize values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=timescaledb
DB_PORT=5432
DB_NAME=industryflow
DB_USER=postgres
DB_PASSWORD=changeme_secure_password

# =============================================================================
# DATABASE ROLES (Application-level access with RLS)
# =============================================================================
# API Gateway Role
API_GATEWAY_DB_USER=api_gateway_user
API_GATEWAY_DB_PASSWORD=changeme_api_gateway_password

# Spark Streaming Role
SPARK_STREAMING_DB_USER=spark_streaming_user
SPARK_STREAMING_DB_PASSWORD=changeme_spark_password

# Alert Service Role
ALERT_SERVICE_DB_USER=alert_service_user
ALERT_SERVICE_DB_PASSWORD=changeme_alert_password

# ML Service Role
ML_SERVICE_DB_USER=ml_service_user
ML_SERVICE_DB_PASSWORD=changeme_ml_password

# MLflow Role (for mlflow database only)
MLFLOW_DB_USER=mlflow_user
MLFLOW_DB_PASSWORD=changeme_mlflow_password

# =============================================================================
# KAFKA CONFIGURATION
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# MINIO (S3) CONFIGURATION
# =============================================================================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_ENDPOINT=http://minio:9000

# =============================================================================
# MLFLOW CONFIGURATION
# =============================================================================
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET_KEY=changeme_generate_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Shared secret authenticating internal service-to-service calls (alert worker -> ML
# inference). Must be set for ML-based alerting; if unset, those internal calls fail closed.
INTERNAL_SERVICE_TOKEN=changeme_generate_secure_internal_service_token

# =============================================================================
# INITIAL ADMIN USERS (for seeding)
# =============================================================================
# Configure admin users for initial setup via scripts/seed_users.py
# Support up to 9 admin users (ADMIN_USER_1, ADMIN_USER_2, etc.)
# Leave blank in production - use scripts/manage_users.py instead

ADMIN_USER_1_EMAIL=
ADMIN_USER_1_PASSWORD=
ADMIN_USER_1_COMPANY_ID=
ADMIN_USER_1_ROLE=admin

# =============================================================================
# SPARK CONFIGURATION
# =============================================================================
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_EXECUTOR_CORES=4

# =============================================================================
# API GATEWAY CONFIGURATION
# =============================================================================
API_GATEWAY_PORT=8000
API_GATEWAY_HOST=0.0.0.0

# =============================================================================
# ALERT SERVICE CONFIGURATION
# =============================================================================
ALERT_SERVICE_PORT=8001

# =============================================================================
# ML SERVICE CONFIGURATION
# =============================================================================
ML_SERVICE_PORT=8002

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_admin_password
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
ENVIRONMENT=development
TZ=Europe/Berlin
