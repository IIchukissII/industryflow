# IndustryFlow v2 Environment Configuration
# Version: 4.0 - NEW ARCHITECTURE
# Copy this file to .env and customize values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=timescaledb
DB_PORT=5432
DB_NAME=industryflow
DB_USER=postgres
DB_PASSWORD=changeme_secure_password

# =============================================================================
# DATABASE ROLES (Application-level access with RLS)
# =============================================================================
# API Gateway Role
API_GATEWAY_DB_USER=api_gateway_user
API_GATEWAY_DB_PASSWORD=changeme_api_gateway_password

# (Ingestion has no database role: it is mTLS-only and produces to Kafka — ADR-0002.)

# Spark Streaming Role
SPARK_STREAMING_DB_USER=spark_streaming_user
SPARK_STREAMING_DB_PASSWORD=changeme_spark_password

# Alert Service Role
ALERT_SERVICE_DB_USER=alert_service_user
ALERT_SERVICE_DB_PASSWORD=changeme_alert_password

# ML Service Role
ML_SERVICE_DB_USER=ml_service_user
ML_SERVICE_DB_PASSWORD=changeme_ml_password

# MLflow Role (for mlflow database only)
MLFLOW_DB_USER=mlflow_user
MLFLOW_DB_PASSWORD=changeme_mlflow_password

# =============================================================================
# KAFKA CONFIGURATION
# =============================================================================
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_TOPIC_SENSOR_DATA=sensor-data-raw
KAFKA_TOPIC_ALERTS=sensor-alerts
KAFKA_GROUP_ID=alert-detector

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# =============================================================================
# MINIO (S3) CONFIGURATION
# =============================================================================
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=changeme_minio_secret
MINIO_ENDPOINT=http://minio:9000

# =============================================================================
# SPARK CHECKPOINT / SCALING (ADR-0006)
# =============================================================================
# The Structured-Streaming checkpoint lives on MinIO via S3A so the driver and every executor
# share ONE store — letting the cluster run multiple workers. Set to a local path (e.g.
# /opt/spark/checkpoints) to opt out of S3A for a single-node dev run.
SPARK_CHECKPOINT_LOCATION=s3a://spark-checkpoints
SPARK_CHECKPOINT_BUCKET=spark-checkpoints
# Worker pool size. Scale out: raise this (or `docker compose up -d --scale spark-worker=N`).
SPARK_WORKER_REPLICAS=1

# =============================================================================
# DATABASE BACKUPS (tier-1 DR) — used by the `backup`-profile db-backup service.
# Defaults target the in-cluster MinIO; point at off-site S3 for real DR.
# See docs/operations/backup-and-recovery.md.
# =============================================================================
# =============================================================================
# DATABASE TLS (ADR-0017). verify-full = encrypt + verify the server cert against the
# internal CA. Run scripts/gen-internal-ca.sh and set TLS_CERT_DIR so clients get ca.crt.
# For a bare dev stack with no generated certs, set DB_SSLMODE=disable.
# =============================================================================
DB_SSLMODE=verify-full

BACKUP_S3_BUCKET=industryflow-backups
BACKUP_S3_PREFIX=timescaledb
BACKUP_S3_REGION=us-east-1
BACKUP_DATABASES=industryflow mlflow
BACKUP_RETAIN_PER_DB=14

# =============================================================================
# MLFLOW CONFIGURATION
# =============================================================================
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_DB_NAME=mlflow

# =============================================================================
# JWT AUTHENTICATION
# =============================================================================
JWT_SECRET_KEY=changeme_generate_secure_jwt_secret_key_here
JWT_ALGORITHM=HS256
# Short-lived access token + revocable rotating refresh token (ADR-0004).
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# httpOnly cookie auth + CSRF (ADR-0004 dec 3). COOKIE_SECURE MUST be true in production
# (requires HTTPS); false only for local plain-HTTP development.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Shared secret authenticating internal service-to-service calls (alert worker -> ML
# inference/drift). Must be set for ML-based alerting; if unset, those internal calls fail closed.
INTERNAL_SERVICE_TOKEN=changeme_generate_secure_internal_service_token

# ML service base URL the alert worker calls for ML inference + drift evaluation. The default
# matches the compose service name; in Kubernetes the Helm chart sets the release-scoped host.
ML_SERVICE_URL=http://ml-service-api:8002

# Model-drift monitoring (ADR-0021). The alert worker's scheduled evaluator asks the ML service
# whether a model's recent data has drifted from its training baseline.
#   DRIFT_EVAL_INTERVAL   - seconds between drift evaluation passes (default hourly)
#   DRIFT_WINDOW_MINUTES  - trailing window compared against the baseline (default 24h)
#   DRIFT_SHARE_THRESHOLD - default drifted-feature share that trips an alert when a rule
#                           pins no threshold of its own (0..1)
DRIFT_EVAL_INTERVAL=3600
DRIFT_WINDOW_MINUTES=1440
DRIFT_SHARE_THRESHOLD=0.5

# Warm model cache size in the ML service (loaded MLflow models reused across inference + drift).
MODEL_CACHE_SIZE=8

# =============================================================================
# INITIAL ADMIN USERS (for seeding)
# =============================================================================
# Configure admin users for initial setup via scripts/seed_users.py
# Support up to 9 admin users (ADMIN_USER_1, ADMIN_USER_2, etc.)
# No tenants are seeded: create one first with `scripts/create-tenant.sh "Your Company"`
# and put the company_id it prints into ADMIN_USER_1_COMPANY_ID below.

ADMIN_USER_1_EMAIL=
ADMIN_USER_1_PASSWORD=
ADMIN_USER_1_COMPANY_ID=
ADMIN_USER_1_ROLE=admin

# =============================================================================
# SPARK CONFIGURATION
# =============================================================================
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
SPARK_EXECUTOR_CORES=4

# =============================================================================
# API GATEWAY CONFIGURATION
# =============================================================================
API_GATEWAY_PORT=8000
API_GATEWAY_HOST=0.0.0.0

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# The frontend nginx is the TLS edge (ADR-0004 dec 1): HTTPS on FRONTEND_HTTPS_PORT, with
# plain HTTP on FRONTEND_PORT redirecting to it. A self-signed cert is generated locally;
# mount a real one at /etc/nginx/certs (tls.crt/tls.key) in production.
# For a clean LAN URL (https://industryflow.local with no port and a working http redirect),
# use the standard ports 80/443; on a dev laptop keep the high ports below.
FRONTEND_PORT=3000
FRONTEND_HTTPS_PORT=3443
# Extra SANs for the self-signed dev cert so the browser trusts it under more names/IPs,
# e.g. CERT_EXTRA_SAN=IP:192.168.178.55 to also reach it by the host's LAN IP.
CERT_EXTRA_SAN=
# To serve a REAL CA-signed cert (no browser warning) instead of the self-signed default:
# run scripts/gen-internal-ca.sh, install its deploy/certs/ca.crt on your devices once, and
# set TLS_CERT_DIR to that output dir (absolute path). Leave empty to self-sign.
# See docs/operations/tls.md.
TLS_CERT_DIR=
# mTLS ingestion edge (ADR-0002/0007): device producers connect here with a client cert
# issued by scripts/device-ca.sh. DEVICE_CA_DIR holds the CA chain + CRL the edge verifies
# against; ingestion-service itself has no host port (reachable only via this edge).
INGESTION_MTLS_PORT=8443
DEVICE_CA_DIR=./deploy/device-ca

# Extension plugins (ADR-0008/0010): comma-separated importable module names the ML service
# loads at startup to register domain feature transforms. Empty = generic built-ins only.
# The module must be on the service's import path. Example: EXTENSION_MODULES=tep_reference
EXTENSION_MODULES=
# REACT_APP_* are baked at build time. Empty = same-origin (served behind the nginx proxy
# that forwards /api, /auth, /users, /ws to the gateway). Set only for a direct/dev build,
# e.g. REACT_APP_API_URL=http://localhost:8000
REACT_APP_API_URL=
REACT_APP_WS_URL=

# =============================================================================
# ALERT SERVICE CONFIGURATION
# =============================================================================
ALERT_SERVICE_PORT=8001
RULE_RELOAD_INTERVAL=60
# Per (rule, sensor) cooldown: suppress duplicate alerts within this many seconds
# (dedup / anti-storm — ADR-0005). 0 disables the cooldown.
ALERT_COOLDOWN_SECONDS=300

# =============================================================================
# INGESTION SERVICE CONFIGURATION
# =============================================================================
INGESTION_SERVICE_PORT=8003

# =============================================================================
# ML SERVICE CONFIGURATION
# =============================================================================
ML_SERVICE_PORT=8002

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_admin_password
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# =============================================================================
# NOTEBOOK HUB (ADR-0011/0014/0018) — opt-in `notebooks` compose profile.
# Multi-tenant, per-user, non-root notebooks (JupyterHub + DockerSpawner) reached through the SSO
# proxy. Bring up:  docker compose --profile notebooks build
#                  docker compose --profile notebooks up -d notebook-hub notebook-sso
# =============================================================================
NOTEBOOK_PORT=8888
# Host's docker group gid, so the hub reaches the Docker socket WITHOUT running as root.
# Find it with:  getent group docker | cut -d: -f3
DOCKER_GID=999
# Gateway origin the kernel's tenant-scoped client calls (in-cluster service name on compose).
INDUSTRYFLOW_API_URL=http://api-gateway:8000
# Encrypts the verified tenant/role the hub carries to the spawn hook (enable_auth_state).
# REQUIRED — the hub will not start without it. Generate:  openssl rand -hex 32
JUPYTERHUB_CRYPT_KEY=CHANGE_ME_openssl_rand_hex_32
# SQL access proxy (ADR-0015). Password for the privileged `notebook_sql_proxy` DB role the proxy
# logs in as (created by 13-notebook-sql-proxy-role.sh only when this is set). Authoring kernels
# never see it — they authenticate to the proxy with their per-session SQL capability handle.
NOTEBOOK_SQL_PROXY_DB_PASSWORD=changeme_sql_proxy_password
# Where authoring kernels reach the proxy (defaults to the compose service name). The kernel's
# client uses its SQL capability handle as the password against this endpoint.
INDUSTRYFLOW_SQL_PROXY_URL=postgresql://notebook-sql-proxy:6432/industryflow

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
ENVIRONMENT=development
TZ=Europe/Berlin

# Allowed CORS origins for the API gateway: an explicit allowlist, never "*" combined
# with credentials (ADR-0004). Comma-separated for multiple origins.
CORS_ORIGINS=http://localhost:3000
