{{- define "industryflow.name" -}}
{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" -}}
{{- end -}}

{{- define "industryflow.fullname" -}}
{{- if .Values.fullnameOverride -}}
{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" -}}
{{- else -}}
{{- printf "%s-%s" .Release.Name (include "industryflow.name" .) | trunc 63 | trimSuffix "-" -}}
{{- end -}}
{{- end -}}

{{- define "industryflow.labels" -}}
app.kubernetes.io/part-of: industryflow
app.kubernetes.io/managed-by: {{ .Release.Service }}
helm.sh/chart: {{ printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" }}
{{- end -}}

{{/*
Compose a first-party image reference, preferring an immutable digest over the mutable tag.
Call with a dict: registry, image, tag, digest. When `digest` is set it wins (registry/image@sha256:…)
and the tag is ignored; otherwise falls back to registry/image:tag (dev default). Production
overlays (values-digests.yaml, generated by scripts/pin-image-digests.sh) supply the digests.
*/}}
{{- define "industryflow.image" -}}
{{- if .digest -}}
{{- printf "%s/%s@%s" .registry .image .digest -}}
{{- else -}}
{{- printf "%s/%s:%s" .registry .image .tag -}}
{{- end -}}
{{- end -}}

{{/* Legacy single-secret name (kept for the existingSecret fallback). */}}
{{- define "industryflow.secretName" -}}
{{- if .Values.secrets.existingSecret -}}
{{- .Values.secrets.existingSecret -}}
{{- else -}}
{{- printf "%s-secrets" (include "industryflow.fullname" .) -}}
{{- end -}}
{{- end -}}

{{/*
Per-workload scoped Secret name. Call with a dict: ctx (root context), workload (string).
When secrets.existingSecret is set, every workload references that one Secret (the operator
scopes at their backend); otherwise each workload gets its own `<fullname>-<workload>-secrets`.
*/}}
{{- define "industryflow.workloadSecretName" -}}
{{- $ctx := .ctx -}}
{{- if $ctx.Values.secrets.existingSecret -}}
{{- $ctx.Values.secrets.existingSecret -}}
{{- else -}}
{{- printf "%s-%s-secrets" (include "industryflow.fullname" $ctx) .workload -}}
{{- end -}}
{{- end -}}

{{/*
Render a scoped Opaque Secret for one workload. Call with a dict: ctx, workload, keys (list).
Each key's value is selected from .Values.secrets.data, so the master map stays the single
source of values while each workload's Secret carries only the keys it needs.
*/}}
{{- define "industryflow.scopedSecret" -}}
{{- $ctx := .ctx -}}
apiVersion: v1
kind: Secret
metadata:
  name: {{ include "industryflow.workloadSecretName" (dict "ctx" $ctx "workload" .workload) }}
  labels:
    {{- include "industryflow.labels" $ctx | nindent 4 }}
    app.kubernetes.io/name: {{ .workload }}
type: Opaque
stringData:
{{- range $k := .keys }}
  {{ $k }}: {{ index $ctx.Values.secrets.data $k | quote }}
{{- end }}
{{- end -}}

{{/*
The per-service role passwords the migration runner's role scripts set (00-create-roles.sh and
13-notebook-sql-proxy-role.sh create one role from each). ONE list for both consumers: the db-migrate
scoped Secret carries exactly these keys and the Job passes exactly these into the container, so a
role cannot be put in one and forgotten in the other (it would be created with no password). Returned space-separated; callers `splitList " "` it.
*/}}
{{- define "industryflow.timescaledbRoleKeys" -}}
{{- $keys := list "API_GATEWAY_DB_PASSWORD" "SPARK_STREAMING_DB_PASSWORD" "ALERT_SERVICE_DB_PASSWORD" "ML_SERVICE_DB_PASSWORD" "MLFLOW_DB_PASSWORD" "METRICS_DB_PASSWORD" -}}
{{- /* The notebook SQL proxy role (ADR-0015). */ -}}
{{- if .Values.notebookHub.enabled }}{{ $keys = append $keys "NOTEBOOK_SQL_PROXY_DB_PASSWORD" }}{{ end -}}
{{- /* The cold_export_user role (ADR-0025). */ -}}
{{- if .Values.coldExport.enabled }}{{ $keys = append $keys "COLD_EXPORT_DB_PASSWORD" }}{{ end -}}
{{- /* The tenant_delete_user role (ADR-0033 dec 4). */ -}}
{{- if .Values.tenantDelete.enabled }}{{ $keys = append $keys "TENANT_DELETE_DB_PASSWORD" }}{{ end -}}
{{- /* The notebook_hub_reclaim_user role (ADR-0020 dec 6). */ -}}
{{- if and .Values.notebookHub.enabled .Values.tenantDelete.enabled }}{{ $keys = append $keys "NOTEBOOK_HUB_RECLAIM_DB_PASSWORD" }}{{ end -}}
{{- join " " $keys -}}
{{- end -}}

{{/* Resolve the TimescaleDB host: in-cluster service name or external host. */}}
{{- define "industryflow.dbHost" -}}
{{- if .Values.infra.timescaledb.inCluster -}}
{{- printf "%s-timescaledb" (include "industryflow.fullname" .) -}}
{{- else -}}
{{- required "infra.timescaledb.external.host is required when inCluster=false" .Values.infra.timescaledb.external.host -}}
{{- end -}}
{{- end -}}

{{/* Resolve the Kafka bootstrap servers. */}}
{{- define "industryflow.kafkaBootstrap" -}}
{{- if .Values.infra.kafka.inCluster -}}
{{- printf "%s-kafka:%v" (include "industryflow.fullname" .) .Values.infra.kafka.port -}}
{{- else -}}
{{- required "infra.kafka.external.bootstrap is required when inCluster=false" .Values.infra.kafka.external.bootstrap -}}
{{- end -}}
{{- end -}}

{{/* Resolve the Redis host. */}}
{{- define "industryflow.redisHost" -}}
{{- if .Values.infra.redis.inCluster -}}
{{- printf "%s-redis" (include "industryflow.fullname" .) -}}
{{- else -}}
{{- required "infra.redis.external.host is required when inCluster=false" .Values.infra.redis.external.host -}}
{{- end -}}
{{- end -}}

{{/* Resolve the MinIO endpoint (host:port). */}}
{{- define "industryflow.minioEndpoint" -}}
{{- if .Values.infra.minio.inCluster -}}
{{- printf "http://%s-minio:%v" (include "industryflow.fullname" .) .Values.infra.minio.apiPort -}}
{{- else -}}
{{- required "infra.minio.external.endpoint is required when inCluster=false" .Values.infra.minio.external.endpoint -}}
{{- end -}}
{{- end -}}

{{/* Resolve the MLflow tracking URI. */}}
{{- define "industryflow.mlflowUri" -}}
{{- if .Values.infra.mlflow.inCluster -}}
{{- printf "http://%s-mlflow:%v" (include "industryflow.fullname" .) .Values.infra.mlflow.port -}}
{{- else -}}
{{- required "infra.mlflow.external.trackingUri is required when inCluster=false" .Values.infra.mlflow.external.trackingUri -}}
{{- end -}}
{{- end -}}

{{/*
The cluster-internal FQDN of one of this release's Services. Call with a dict: ctx, name (the
suffix after the fullname). Fully qualified because the edge re-resolves its upstreams through a
resolver, and a resolver applies no search domains.
*/}}
{{- define "industryflow.serviceFqdn" -}}
{{- $ctx := .ctx -}}
{{- printf "%s-%s.%s.svc.%s" (include "industryflow.fullname" $ctx) .name $ctx.Release.Namespace $ctx.Values.clusterDomain -}}
{{- end -}}

{{/*
The frontend edge's upstreams (services/frontend/nginx.conf.template): the release's Service FQDNs.
The container refuses to start without every one of them, so this list and the template's
variables move together (tests/config_guards renders both and compares).
*/}}
{{- define "industryflow.edgeEnv" -}}
{{- $apps := .Values.apps -}}
- name: EDGE_API_GATEWAY
  value: {{ printf "%s:%v" (include "industryflow.serviceFqdn" (dict "ctx" . "name" "api-gateway")) (index $apps "api-gateway").port | quote }}
- name: EDGE_ML_SERVICE
  value: {{ printf "%s:%v" (include "industryflow.serviceFqdn" (dict "ctx" . "name" "ml-service-api")) (index $apps "ml-service-api").port | quote }}
- name: EDGE_NOTEBOOK_SSO
  value: {{ printf "%s:%v" (include "industryflow.serviceFqdn" (dict "ctx" . "name" "notebook-sso")) .Values.notebookHub.ssoProxy.port | quote }}
- name: EDGE_TRACKING_GATEWAY
  value: {{ printf "%s:%v" (include "industryflow.serviceFqdn" (dict "ctx" . "name" "notebook-tracking-gateway")) .Values.notebookHub.trackingGateway.port | quote }}
- name: EDGE_OBJECT_STORE_URL
  {{- if .Values.infra.minio.inCluster }}
  value: {{ printf "http://%s:%v" (include "industryflow.serviceFqdn" (dict "ctx" . "name" "minio")) .Values.infra.minio.apiPort | quote }}
  {{- else }}
  value: {{ .Values.infra.minio.external.endpoint | quote }}
  {{- end }}
{{- end -}}

{{/*
The object-store principals the minio-init Job provisions in this release, as their secret key
names (space-separated; callers `splitList " "` it). ONE list for the Job's Secret and its env, so a
principal is never half-wired. Each is created only where its consumer is deployed.
*/}}
{{- define "industryflow.objectStorePrincipalKeys" -}}
{{- $keys := list "SPARK_CHECKPOINT_ACCESS_KEY" "SPARK_CHECKPOINT_SECRET_KEY" -}}
{{- if .Values.infra.mlflow.inCluster }}{{ $keys = concat $keys (list "MLFLOW_STORE_ACCESS_KEY" "MLFLOW_STORE_SECRET_KEY") }}{{ end -}}
{{- if (index .Values.apps "ml-service-api").enabled }}{{ $keys = concat $keys (list "MODEL_READ_ACCESS_KEY" "MODEL_READ_SECRET_KEY") }}{{ end -}}
{{- if .Values.notebookHub.enabled }}{{ $keys = concat $keys (list "TRACKING_STORE_ACCESS_KEY" "TRACKING_STORE_SECRET_KEY") }}{{ end -}}
{{- if and .Values.backup.enabled (not .Values.backup.s3.endpoint) }}{{ $keys = concat $keys (list "BACKUP_STORE_ACCESS_KEY" "BACKUP_STORE_SECRET_KEY") }}{{ end -}}
{{- if .Values.backup.enabled }}{{ $keys = concat $keys (list "BACKUP_READ_ACCESS_KEY" "BACKUP_READ_SECRET_KEY") }}{{ end -}}
{{- if .Values.coldExport.enabled }}{{ $keys = concat $keys (list "COLD_STORE_ACCESS_KEY" "COLD_STORE_SECRET_KEY" "COLD_READ_ACCESS_KEY" "COLD_READ_SECRET_KEY") }}{{ end -}}
{{- if and .Values.coldExport.enabled .Values.tenantDelete.enabled }}{{ $keys = concat $keys (list "TENANT_DELETE_COLD_ACCESS_KEY" "TENANT_DELETE_COLD_SECRET_KEY") }}{{ end -}}
{{- join " " $keys -}}
{{- end -}}

{{/*
Schema-ready gate (ADR-0034 dec 10): an init container that holds a database client until the
ledger shows every platform script applied (`migrate.sh verify --wait`, read-only, as the client's
own role). Kubernetes has no start order across workloads, so this is how a service never starts
against a database the ledger shows behind. A client of the tracking database (database "mlflow")
cannot read the platform ledger; it waits for its own login instead, which exists only once the
runner has created its database and role. Call with a dict: ctx, user, workload (whose scoped
Secret holds the password), passwordKey, and optionally database. Pair with schemaReadyVolumes.
*/}}
{{- define "industryflow.schemaReadyInitContainer" -}}
{{- $ctx := .ctx -}}
{{- $m := $ctx.Values.dbMigrations -}}
{{- $db := .database | default $ctx.Values.infra.timescaledb.database -}}
- name: schema-ready
  image: {{ $ctx.Values.infra.timescaledb.image | quote }}
  {{- if eq $db "mlflow" }}
  command: ["sh", "-c", "until psql -X -qtA -c 'SELECT 1' >/dev/null; do echo 'waiting for the tracking database'; sleep 5; done"]
  {{- else }}
  command: ["sh", "/opt/db-migrations/migrate.sh", "verify", "--wait"]
  {{- end }}
  env:
    - { name: PGHOST, value: {{ include "industryflow.dbHost" $ctx | quote }} }
    - { name: PGPORT, value: {{ $ctx.Values.infra.timescaledb.port | quote }} }
    - { name: PGDATABASE, value: {{ $db | quote }} }
    - { name: PGUSER, value: {{ .user | quote }} }
    - name: PGPASSWORD
      valueFrom:
        secretKeyRef:
          name: {{ include "industryflow.workloadSecretName" (dict "ctx" $ctx "workload" .workload) }}
          key: {{ .passwordKey }}
    {{- if $ctx.Values.tls.db.enabled }}
    - { name: PGSSLMODE, value: {{ $ctx.Values.tls.db.sslmode | quote }} }
    - { name: PGSSLROOTCERT, value: /opt/schema-ready-ca/ca.crt }
    {{- end }}
    - { name: MIGRATIONS_DIR, value: /opt/db-migrations }
    - { name: MIGRATE_WAIT_SECONDS, value: {{ $m.waitSeconds | quote }} }
    - { name: TMPDIR, value: /tmp }
  securityContext:
    runAsNonRoot: true
    runAsUser: {{ $ctx.Values.tls.db.postgresUser }}
    allowPrivilegeEscalation: false
    readOnlyRootFilesystem: true
    capabilities:
      drop: ["ALL"]
  resources:
    requests: { cpu: 10m, memory: 16Mi }
    limits: { cpu: 100m, memory: 64Mi }
  volumeMounts:
    - { name: schema-ready-scripts, mountPath: /opt/db-migrations, readOnly: true }
    - { name: schema-ready-tmp, mountPath: /tmp }
    {{- if $ctx.Values.tls.db.enabled }}
    - { name: schema-ready-ca, mountPath: /opt/schema-ready-ca, readOnly: true }
    {{- end }}
{{- end -}}

{{/* The volumes schemaReadyInitContainer mounts. Call with the root context. */}}
{{- define "industryflow.schemaReadyVolumes" -}}
- name: schema-ready-scripts
  configMap:
    name: {{ include "industryflow.fullname" . }}-db-migrations
- name: schema-ready-tmp
  emptyDir: {}
{{- if .Values.tls.db.enabled }}
- name: schema-ready-ca
  secret:
    secretName: {{ .Values.tls.db.secretName | quote }}
    items:
      - { key: ca.crt, path: ca.crt }
{{- end }}
{{- end -}}
