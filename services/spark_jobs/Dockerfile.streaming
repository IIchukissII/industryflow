FROM apache/spark:4.1.2-python3

# Build arguments for version tracking
ARG BUILD_DATE
ARG VERSION=1.0.0
ARG VCS_REF=unknown

# Metadata
LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.title="IndustryFlow Spark Streaming" \
      org.opencontainers.image.description="Schema-per-tenant Kafka to TimescaleDB streaming"

USER root

# Install Python and pip (with cleanup)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3-pip \
        curl && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip3 install --no-cache-dir \
    psycopg2-binary==2.9.10

# S3A filesystem for an object-storage checkpoint (multi-worker / spark-on-k8s — ADR-0006,
# docs/architecture/stream-processing.md). Baked in (not --packages) so the versions are pinned
# to this image's Hadoop (3.4.2) and resolve offline on every node. Spark 4 bundles Hadoop 3.4.x,
# whose S3A uses the AWS SDK v2 (software.amazon.awssdk:bundle), not the v1 aws-java-sdk-bundle.
RUN curl -fsSL -o /opt/spark/jars/hadoop-aws-3.4.2.jar \
        https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.4.2/hadoop-aws-3.4.2.jar && \
    curl -fsSL -o /opt/spark/jars/bundle-2.35.4.jar \
        https://repo1.maven.org/maven2/software/amazon/awssdk/bundle/2.35.4/bundle-2.35.4.jar

# Create directories with proper permissions
RUN mkdir -p /app/spark_streaming && \
    mkdir -p /opt/spark/checkpoints && \
    mkdir -p /home/spark/.ivy2 && \
    chown -R spark:spark /opt/spark/checkpoints && \
    chown -R spark:spark /home/spark/.ivy2 && \
    chown -R spark:spark /app

# Spark -> Prometheus metrics config, read automatically from conf/metrics.properties (item 7).
COPY metrics.properties /opt/spark/conf/metrics.properties

# Copy the spark streaming script + the FK-resilience helper (shipped to executors via --py-files)
COPY kafka_to_timescaledb.py upsert_filter.py /app/spark_streaming/
RUN chown -R spark:spark /app/spark_streaming && \
    chmod 644 /app/spark_streaming/kafka_to_timescaledb.py /app/spark_streaming/upsert_filter.py

# Switch to spark user to pre-download dependencies
USER spark

# Pre-download Spark packages to avoid runtime issues
RUN /opt/spark/bin/spark-submit \
    --packages org.apache.spark:spark-sql-kafka-0-10_2.13:4.1.2,org.postgresql:postgresql:42.7.4 \
    --class org.apache.spark.sql.kafka010.KafkaSourceProvider \
    --help > /dev/null 2>&1 || true

WORKDIR /app

# Health check - verify process is running
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD pgrep -f "kafka_to_timescaledb.py" || exit 1

# Run the streaming job. The master is NOT set here — the job reads it from SPARK_MASTER
# (default local[*]) in its SparkSession builder, so the master has one source of truth.
# Passing --master here would be a misleading no-op (the builder's .master() overrides it).
CMD ["/opt/spark/bin/spark-submit", \
     "--packages", "org.apache.spark:spark-sql-kafka-0-10_2.13:4.1.2,org.postgresql:postgresql:42.7.4", \
     "--conf", "spark.sql.streaming.checkpointLocation=/opt/spark/checkpoints", \
     "--py-files", "/app/spark_streaming/upsert_filter.py", \
     "/app/spark_streaming/kafka_to_timescaledb.py"]