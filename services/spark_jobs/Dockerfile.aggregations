FROM apache/spark:4.1.3-java21-python3

# Build arguments for version tracking
ARG BUILD_DATE
ARG VERSION=1.0.0
ARG VCS_REF=unknown

# Metadata
LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.title="IndustryFlow Spark Aggregations" \
      org.opencontainers.image.description="Schema-per-tenant time-series aggregations"

USER root

# Install Python and pip (with cleanup). The `upgrade` is the OS-patch layer: apache/spark pins an
# Ubuntu that goes CRITICAL between Spark releases, so this image patches at build rather than wait
# for upstream to re-cut. That only holds if the layer actually re-runs — the build restores layers
# from a persistent cache (.github/workflows/images.yml), which replays this RUN verbatim and would
# freeze the patch level at whatever the last cache write held while .trivyignore still claims these
# CVEs are fixed rather than accepted. SECURITY_REFRESH is a cache epoch the workflow advances daily;
# it is referenced below for no reason other than to move this layer's cache key with it.
ARG SECURITY_REFRESH=unset
RUN echo "security refresh: ${SECURITY_REFRESH}" && \
    apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
        python3-pip \
        curl && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip3 install --no-cache-dir \
    psycopg2-binary==2.9.10

# S3A filesystem for an object-storage checkpoint (multi-worker / spark-on-k8s — ADR-0006,
# docs/architecture/stream-processing.md). Baked in (not --packages) so the versions are pinned
# to this image's Hadoop (3.4.2) and resolve offline on every node. Spark 4 bundles Hadoop 3.4.x,
# whose S3A uses the AWS SDK v2 (software.amazon.awssdk:bundle), not the v1 aws-java-sdk-bundle.
# The jar versions, the netty patch set and the removals live in patch-spark-jars.sh, shared by all
# three Spark images.
COPY patch-spark-jars.sh /tmp/patch-spark-jars.sh
RUN sh /tmp/patch-spark-jars.sh && rm /tmp/patch-spark-jars.sh

# Create directories with proper permissions. The spark user needs a writable home for ivy's cache:
# Spark 4's base sets the user's passwd home to /nonexistent and ivy derives its cache dir from the
# JVM's user.home — so a `--packages` resolution would write under /nonexistent and die at submit.
# spark-defaults.conf (below) redirects ivy to /home/spark/.ivy2, so that directory must be writable
# by the spark user.
RUN mkdir -p /app/spark_streaming && \
    mkdir -p /opt/spark/checkpoints && \
    mkdir -p /home/spark/.ivy2 && \
    chown -R spark:spark /opt/spark/checkpoints && \
    chown -R spark:spark /home/spark && \
    chown -R spark:spark /app

# Spark -> Prometheus metrics config, read automatically from conf/metrics.properties (item 7).
COPY metrics.properties /opt/spark/conf/metrics.properties
# Redirect ivy's --packages cache to a writable, image-baked dir (see the file's own comment).
COPY spark-defaults.conf /opt/spark/conf/spark-defaults.conf

# Copy the spark aggregations script + the local modules it imports (also shipped to executors via
# --py-files). tests/test_image_modules.py holds this list, the chmod and --py-files to the imports.
COPY kafka_aggregations.py aggregation_windows.py reading_guard.py /app/spark_streaming/
# The container health check (not imported by the job, so not in --py-files).
COPY healthcheck.py /app/spark_streaming/
# The platform's shared tenant-naming and window contract (libs/industryflow_contracts; ADR-0003
# dec 5-7, ADR-0006 dec 7), from the named build context `contracts`. The driver imports it from the
# job's directory; the zip is what --py-files ships to the executors.
COPY --from=contracts industryflow_contracts/ /app/spark_streaming/industryflow_contracts/
RUN cd /app/spark_streaming && python3 -m zipfile -c industryflow_contracts.zip industryflow_contracts/
RUN chown -R spark:spark /app/spark_streaming && \
    chmod 644 /app/spark_streaming/kafka_aggregations.py /app/spark_streaming/aggregation_windows.py \
        /app/spark_streaming/reading_guard.py

# Switch to spark user to pre-download dependencies
USER spark

# Resolve the runtime packages at BUILD time. This both warms the ivy cache into the image — so the
# job starts offline, with no Maven round-trip on every restart — AND gates the coordinate: a Kafka
# connector built for the wrong Scala/Spark version fails the build here, not at 3am on a restart.
# A throwaway local[1] submit of a no-op script is used because --help/--version exit before
# spark-submit resolves --packages (the script never builds a SparkContext, so nothing binds a port).
RUN printf "print('ivy warm ok')\n" > /tmp/warm.py && \
    /opt/spark/bin/spark-submit --master "local[1]" \
        --packages org.apache.spark:spark-sql-kafka-0-10_2.13:4.1.3,org.postgresql:postgresql:42.7.4 \
        /tmp/warm.py && \
    rm -f /tmp/warm.py

WORKDIR /app

# Health: the job has compute (driver UI: an application with an active executor, or local mode),
# not merely a live process — a job WAITING on the master for resources is unhealthy (healthcheck.py).
HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
    CMD ["python3", "/app/spark_streaming/healthcheck.py"]

# Run the aggregations job. Master is set once via SPARK_MASTER (default local[*]) in the
# job's SparkSession builder — not here — so there is a single source of truth.
CMD ["/opt/spark/bin/spark-submit", \
     "--packages", "org.apache.spark:spark-sql-kafka-0-10_2.13:4.1.3,org.postgresql:postgresql:42.7.4", \
     "--conf", "spark.sql.streaming.checkpointLocation=/opt/spark/checkpoints", \
     "--py-files", "/app/spark_streaming/aggregation_windows.py,/app/spark_streaming/reading_guard.py,/app/spark_streaming/industryflow_contracts.zip", \
     "/app/spark_streaming/kafka_aggregations.py"]