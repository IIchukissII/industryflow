FROM apache/spark:4.1.2-python3

# Build arguments for version tracking
ARG BUILD_DATE
ARG VERSION=1.0.0
ARG VCS_REF=unknown

# Metadata
LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.title="IndustryFlow Spark Aggregations" \
      org.opencontainers.image.description="Schema-per-tenant time-series aggregations"

USER root

# Install Python and pip (with cleanup)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3-pip \
        curl && \
    rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip3 install --no-cache-dir \
    psycopg2-binary==2.9.10

# S3A filesystem for an object-storage checkpoint (multi-worker / spark-on-k8s — ADR-0006,
# docs/architecture/stream-processing.md). Baked in (not --packages) so the versions are pinned
# to this image's Hadoop (3.4.2) and resolve offline on every node. Spark 4 bundles Hadoop 3.4.x,
# whose S3A uses the AWS SDK v2 (software.amazon.awssdk:bundle), not the v1 aws-java-sdk-bundle.
RUN curl -fsSL -o /opt/spark/jars/hadoop-aws-3.4.2.jar \
        https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/3.4.2/hadoop-aws-3.4.2.jar && \
    curl -fsSL -o /opt/spark/jars/bundle-2.35.4.jar \
        https://repo1.maven.org/maven2/software/amazon/awssdk/bundle/2.35.4/bundle-2.35.4.jar

# Create directories with proper permissions. The spark user needs a writable home for ivy's cache:
# Spark 4's base sets the user's passwd home to /nonexistent and ivy derives its cache dir from the
# JVM's user.home — so a `--packages` resolution would write under /nonexistent and die at submit.
# spark-defaults.conf (below) redirects ivy to /home/spark/.ivy2, so that directory must be writable
# by the spark user.
RUN mkdir -p /app/spark_streaming && \
    mkdir -p /opt/spark/checkpoints && \
    mkdir -p /home/spark/.ivy2 && \
    chown -R spark:spark /opt/spark/checkpoints && \
    chown -R spark:spark /home/spark && \
    chown -R spark:spark /app

# Spark -> Prometheus metrics config, read automatically from conf/metrics.properties (item 7).
COPY metrics.properties /opt/spark/conf/metrics.properties
# Redirect ivy's --packages cache to a writable, image-baked dir (see the file's own comment).
COPY spark-defaults.conf /opt/spark/conf/spark-defaults.conf

# Copy the spark aggregations script
COPY kafka_aggregations.py /app/spark_streaming/
RUN chown -R spark:spark /app/spark_streaming && \
    chmod 644 /app/spark_streaming/kafka_aggregations.py

# Switch to spark user to pre-download dependencies
USER spark

# Resolve the runtime packages at BUILD time. This both warms the ivy cache into the image — so the
# job starts offline, with no Maven round-trip on every restart — AND gates the coordinate: a Kafka
# connector built for the wrong Scala/Spark version fails the build here, not at 3am on a restart.
# A throwaway local[1] submit of a no-op script is used because --help/--version exit before
# spark-submit resolves --packages (the script never builds a SparkContext, so nothing binds a port).
RUN printf "print('ivy warm ok')\n" > /tmp/warm.py && \
    /opt/spark/bin/spark-submit --master "local[1]" \
        --packages org.apache.spark:spark-sql-kafka-0-10_2.13:4.1.2,org.postgresql:postgresql:42.7.4 \
        /tmp/warm.py && \
    rm -f /tmp/warm.py

WORKDIR /app

# Health check - verify process is running
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD pgrep -f "kafka_aggregations.py" || exit 1

# Run the aggregations job. Master is set once via SPARK_MASTER (default local[*]) in the
# job's SparkSession builder — not here — so there is a single source of truth.
CMD ["/opt/spark/bin/spark-submit", \
     "--packages", "org.apache.spark:spark-sql-kafka-0-10_2.13:4.1.2,org.postgresql:postgresql:42.7.4", \
     "--conf", "spark.sql.streaming.checkpointLocation=/opt/spark/checkpoints", \
     "/app/spark_streaming/kafka_aggregations.py"]