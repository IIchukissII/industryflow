# Authoring single-user image (ADR-0011 dec 5 — data-scientist profile; ADR-0018).
# NON-ROOT by mandate (ADR-0018 dec 3): runs as uid 1000, never --allow-root. It ships the
# blessed tenant-scoped `industryflow` client with the [sql] extra (ADR-0015) and a lean data-
# science stack, but nothing that grants ambient data access — the kernel's only credentials are
# the capability handles the hub injects at spawn.
#
# BUILD CONTEXT = clients/python (so the client is pip-installable from its pyproject):
#   docker build -f services/notebook_hub/Dockerfile.authoring clients/python
#
# THIS IMAGE IS ONE END OF THE MODEL ARTIFACT PATH (ADR-0027). What it trains, `ml_service` unpickles
# — so the pins below are not this image's private business. numpy's major, scikit-learn's
# major.minor and pandas' major must MATCH the serving image, and xgboost must not be NEWER here than
# there (a model must never cross backwards, into an older reader than wrote it). ADR-0027 dec 3.
#
# `scripts/check_model_env_parity.py` enforces exactly that on every PR, and the round-trip gate
# proves it for real by training here and loading there. So: do not bump numpy / scikit-learn /
# pandas / xgboost in this file alone. The check will stop you, which is the point — it was written
# because ml_service once took numpy 2 by itself and nothing was watching.
#
# Held at 3.12 until #220 was decided (the bump would have settled ADR-0011's deferred package
# supply chain by accident, inside a dependency PR). ADR-0027 decided it; the hold is lifted.
FROM python:3.14-slim

ARG NB_UID=1000
ARG NB_USER=jovyan
# libgomp1 is the OpenMP runtime xgboost loads at import.
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid ${NB_UID} --shell /bin/bash ${NB_USER}

# SECURITY_REFRESH is a cache epoch the workflow advances daily (.github/workflows/images.yml). pip
# and its vendored certifi come from the base image, and the pins below are direct only, so pip and
# each transitive dependency are taken fresh — but only when the layer re-runs, and the persistent
# build cache replays it verbatim. This RUN moves the cache key of every layer after it, so a security
# release of pip or a transitive dependency lands within a day.
ARG SECURITY_REFRESH=unset
RUN echo "security refresh: ${SECURITY_REFRESH}" && pip install --no-cache-dir --upgrade pip

# Notebook runtime: jupyterhub-singleuser (registers the server with the hub) + JupyterLab.
# The jupyterhub pin tracks the HUB's (services/notebook_hub/requirements.txt) — singleuser and hub
# speak a versioned protocol to each other, and 5.x tightened XSRF handling on exactly that path. A
# 4.x singleuser under a 5.x hub is a skew nothing else in CI would catch.
RUN pip install --no-cache-dir \
    jupyterhub==6.1.1 \
    jupyterlab==4.0.9

# The data-science stack, pinned in kernel/requirements.txt (in this build context) so the
# dependency bot sees it alongside ml_service's pins (ADR-0027). Its header explains the pins.
COPY kernel/requirements.txt /tmp/kernel-requirements.txt
RUN pip install --no-cache-dir -r /tmp/kernel-requirements.txt && rm /tmp/kernel-requirements.txt

# The tenant-scoped client + the [sql] extra (psycopg) so the kernel can reach the SQL proxy with
# its capability (ADR-0015), and the [cold] extra (pyarrow) for cold-layer Parquet reads (ADR-0025).
# Built from the context (clients/python).
COPY . /tmp/industryflow-client
RUN pip install --no-cache-dir "/tmp/industryflow-client[sql,cold]" && rm -rf /tmp/industryflow-client

# Ship a read-only worked example into the workspace (ADR-0011): read your data -> features ->
# train -> register a model. Owned by root + mode 0444 so it is an immutable reference — a data
# scientist runs it, then File -> Save Notebook As to adapt their own copy. Their home stays theirs.
COPY examples/getting-started.ipynb /home/${NB_USER}/examples/getting-started.ipynb
RUN chmod 0444 /home/${NB_USER}/examples/getting-started.ipynb

# Durable per-user work dir (ADR-0020): owned by the non-root uid so a freshly-provisioned named
# volume / PVC mounted here initialises writable. Notebooks saved here survive restarts.
RUN mkdir -p /home/${NB_USER}/work && chown ${NB_UID}:${NB_UID} /home/${NB_USER}/work

USER ${NB_UID}
WORKDIR /home/${NB_USER}
ENV HOME=/home/${NB_USER}
# DockerSpawner/KubeSpawner override the command, but default it so the image is runnable alone.
CMD ["jupyterhub-singleuser"]
