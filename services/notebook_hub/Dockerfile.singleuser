# Single-user notebook image spawned by the hub (ADR-0011 authoring profile, ADR-0018).
# NON-ROOT by mandate (ADR-0018 dec 3): runs as uid 1000, never --allow-root. It ships the
# blessed tenant-scoped `industryflow` client (ADR-0011 dec 4) and nothing that grants ambient
# data access — the kernel's only credentials are the capability handles the hub injects at spawn.
#
# BUILD CONTEXT = clients/python (so the client is pip-installable from its pyproject):
#   docker build -f services/notebook_hub/Dockerfile.singleuser clients/python
# Lean on purpose: heavy DS libraries (xgboost/optuna/plotly/…) are a documented follow-up; this
# image proves the spawn → capability → tenant-data chain.
FROM python:3.12-slim

ARG NB_UID=1000
ARG NB_USER=jovyan
RUN useradd --create-home --uid ${NB_UID} --shell /bin/bash ${NB_USER}

# Notebook runtime: jupyterhub-singleuser (registers the server with the hub) + JupyterLab.
RUN pip install --no-cache-dir \
    jupyterhub==4.1.6 \
    jupyterlab==4.0.9

# The tenant-scoped client + its deps from the build context (clients/python). The [sql] extra
# adds psycopg so an authoring kernel can reach the SQL proxy with its capability (ADR-0015).
COPY . /tmp/industryflow-client
RUN pip install --no-cache-dir "/tmp/industryflow-client[sql]" && rm -rf /tmp/industryflow-client

USER ${NB_UID}
WORKDIR /home/${NB_USER}
ENV HOME=/home/${NB_USER}
# DockerSpawner/KubeSpawner override the command, but default it so the image is runnable alone.
CMD ["jupyterhub-singleuser"]
