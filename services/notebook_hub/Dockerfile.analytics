# Analytics single-user image (ADR-0011 dec 5 — the read-only profile; ADR-0018).
# NON-ROOT (ADR-0018 dec 3): uid 1000. This profile serves *rendered reports and their parameters,
# nothing else* (ADR-0011 dec 5): its single-user server is report_server.ReportServerApp, which has no
# kernel, contents, file, terminal or extension route, and runs each curated report here with typed
# parameters, returning HTML without inputs. Data reaches the reports through the tenant-scoped API
# path only (ADR-0011 dec 4); this profile gets NO SQL capability, so the client is installed without
# the [sql] extra.
#
# BUILD CONTEXT = clients/python (so the client is pip-installable from its pyproject):
#   docker build -f services/notebook_hub/Dockerfile.analytics \
#     --build-context analytics=services/notebook_hub/analytics clients/python
#
# NOT ON THE MODEL ARTIFACT PATH, and so NOT bound by ADR-0027's train/serve parity contract
# (dec 12): this profile renders dashboards, it trains nothing and registers nothing, so nothing it
# pins is ever unpickled by ml_service. That its numpy/pandas happen to match the authoring kernel's
# is a coincidence, not a contract — it is free to move on its own cadence, and the parity check
# does not read this file.
#
# It moves to 3.14 here anyway, alongside the authoring kernel: the reason both were held at 3.12 was
# #220 (the undecided artifact-path supply chain), and ADR-0027 has now decided it.
FROM python:3.14-slim

ARG NB_UID=1000
ARG NB_USER=jovyan
RUN useradd --create-home --uid ${NB_UID} --shell /bin/bash ${NB_USER}

# SECURITY_REFRESH is a cache epoch the workflow advances daily (.github/workflows/images.yml). pip
# and its vendored certifi come from the base image, and the pins below are direct only, so pip and
# each transitive dependency are taken fresh — but only when the layer re-runs, and the persistent
# build cache replays it verbatim. This RUN moves the cache key of every layer after it, so a security
# release of pip or a transitive dependency lands within a day.
ARG SECURITY_REFRESH=unset
RUN echo "security refresh: ${SECURITY_REFRESH}" && pip install --no-cache-dir --upgrade pip

# The report server and what it runs reports with: jupyterhub-singleuser wraps it in the hub's
# authentication (JUPYTERHUB_SINGLEUSER_APP below); the kernel runs only the curated reports.
# The jupyterhub pin tracks the HUB's (scripts/check_jupyterhub_parity.py reads it from this file).
COPY --from=analytics requirements.txt /tmp/analytics-requirements.txt
RUN pip install --no-cache-dir -r /tmp/analytics-requirements.txt && rm /tmp/analytics-requirements.txt
COPY --from=analytics report_server.py /opt/industryflow/report_server.py

# Visualisation stack for dashboards (no ML/training libs — operators don't author models).
RUN pip install --no-cache-dir \
    numpy==2.5.1 \
    pandas==2.3.3 \
    matplotlib==3.11.0 \
    plotly==5.23.0

# The tenant-scoped client (data-API path only — no [sql] extra for this profile).
COPY . /tmp/industryflow-client
RUN pip install --no-cache-dir /tmp/industryflow-client && rm -rf /tmp/industryflow-client

# The curated reports (ADR-0011 Deferred: their publication is the maintainer's); read-only to the user.
RUN mkdir -p /opt/industryflow/reports

USER ${NB_UID}
WORKDIR /home/${NB_USER}
ENV HOME=/home/${NB_USER} \
    PYTHONPATH=/opt/industryflow \
    JUPYTERHUB_SINGLEUSER_APP=report_server.ReportServerApp \
    IF_REPORTS_DIR=/opt/industryflow/reports
CMD ["jupyterhub-singleuser"]
