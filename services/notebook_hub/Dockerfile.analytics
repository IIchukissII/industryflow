# Analytics single-user image (ADR-0011 dec 5 — operator profile; ADR-0018).
# NON-ROOT (ADR-0018 dec 3): uid 1000. This profile is *read-only, rendered dashboards — no
# free-form code* (ADR-0011 dec 5): it ships **Voila** (which executes a notebook server-side and
# shows only its outputs/widgets, never an editable code surface) instead of JupyterLab. The hub
# lands analytics users on `/voila` (jupyterhub_config.py). Data reaches the dashboards through
# the tenant-scoped API path only (ADR-0011 dec 4); this profile gets NO SQL capability, so the
# client is installed without the [sql] extra.
#
# BUILD CONTEXT = clients/python (so the client is pip-installable from its pyproject):
#   docker build -f services/notebook_hub/Dockerfile.analytics clients/python
#
# NOT ON THE MODEL ARTIFACT PATH, and so NOT bound by ADR-0027's train/serve parity contract
# (dec 12): this profile renders dashboards, it trains nothing and registers nothing, so nothing it
# pins is ever unpickled by ml_service. That its numpy/pandas happen to match the authoring kernel's
# is a coincidence, not a contract — it is free to move on its own cadence, and the parity check
# does not read this file.
#
# It moves to 3.14 here anyway, alongside the authoring kernel: the reason both were held at 3.12 was
# #220 (the undecided artifact-path supply chain), and ADR-0027 has now decided it.
FROM python:3.14-slim

ARG NB_UID=1000
ARG NB_USER=jovyan
RUN useradd --create-home --uid ${NB_UID} --shell /bin/bash ${NB_USER}

# Notebook runtime: jupyterhub-singleuser registers the server with the hub; Voila renders
# notebooks as read-only dashboards (a jupyter-server extension, reached at /voila). No JupyterLab.
# The jupyterhub pin tracks the HUB's (services/notebook_hub/requirements.txt): singleuser and hub
# speak a versioned protocol, and a 4.x singleuser under the 5.x hub is a skew nothing else catches.
RUN pip install --no-cache-dir \
    jupyterhub==5.5.0 \
    voila==0.5.7

# Visualisation stack for dashboards (no ML/training libs — operators don't author models).
RUN pip install --no-cache-dir \
    numpy==2.5.1 \
    pandas==2.3.3 \
    matplotlib==3.11.0 \
    plotly==5.23.0

# The tenant-scoped client (data-API path only — no [sql] extra for this profile).
COPY . /tmp/industryflow-client
RUN pip install --no-cache-dir /tmp/industryflow-client && rm -rf /tmp/industryflow-client

USER ${NB_UID}
WORKDIR /home/${NB_USER}
ENV HOME=/home/${NB_USER}
# Runnable alone; the hub overrides the command and sets default_url=/voila for this profile.
CMD ["jupyterhub-singleuser"]
